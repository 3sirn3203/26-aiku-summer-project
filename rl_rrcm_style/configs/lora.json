{
  "evaluation": {"enabled": true, "every_steps": 25, "at_start": true, "at_end": true,
                 "limit": null, "selection_metric": "execution_accuracy"},
  "tracking": {"backend": "none", "project": "rl-rrcm-style", "mode": "online",
               "group": "lora", "tags": ["spider", "grpo"]},
  "model": {
    "name_or_path": "Qwen/Qwen2.5-Coder-1.5B-Instruct",
    "mode": "lora",
    "dtype": "float32",
    "device": "auto",
    "target_modules": "all-linear",
    "gradient_checkpointing": true,
    "chat_format": "auto"
  },
  "data": {
    "split_mode": "official",
    "prepared_dir": "rl_rrcm_style/prepared",
    "database_dir": "data/spider_data/database",
    "tables": "data/spider_data/tables.json"
  },
  "sql": {
    "evaluator_path": "overall_pipeline/vendor/spider_test_suite_eval",
    "nltk_data": "data/nltk_data",
    "reward_metric": "execution"
  },
  "rollout": {
